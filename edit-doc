#!/usr/bin/env python3
"""edit-doc: find and replace edits in a Google Doc, as suggestions or outright. Run with --help."""
import os
import sys

sys.dont_write_bytecode = True  # a run leaves the checkout as it found it
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from googledocstools.edit_doc import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
